@page
@model ExpenseManagement.Pages.UsersModel
@{
    ViewData["Title"] = "Users";
}

<div class="page-header">
    <h1>👥 Users</h1>
    <a href="/Users?action=create" class="btn btn-primary">➕ New User</a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-warning">⚠️ @Model.ErrorMessage</div>
}

<!-- Create / Edit form -->
@if (Model.ShowForm)
{
    <section class="form-section">
        <h2>@(Model.EditUser != null ? "Edit User" : "New User")</h2>
        <form method="post">
            <input type="hidden" name="userId" value="@Model.EditUser?.UserId" />
            <div class="form-grid">
                <div class="form-group">
                    <label>Name</label>
                    <input type="text" name="userName" value="@Model.EditUser?.UserName" required />
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" name="email" value="@Model.EditUser?.Email" required />
                </div>
                <div class="form-group">
                    <label>Role</label>
                    <select name="roleId">
                        @foreach (var r in Model.Roles)
                        {
                            <option value="@r.RoleId" selected="@(Model.EditUser?.RoleId == r.RoleId)">@r.RoleName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Manager</label>
                    <select name="managerId">
                        <option value="">— None —</option>
                        @foreach (var u in Model.AllUsers.Where(u => u.RoleName == "Manager"))
                        {
                            <option value="@u.UserId" selected="@(Model.EditUser?.ManagerId == u.UserId)">@u.UserName</option>
                        }
                    </select>
                </div>
                @if (Model.EditUser != null)
                {
                    <div class="form-group">
                        <label>Active</label>
                        <input type="checkbox" name="isActive" value="true"
                               checked="@Model.EditUser.IsActive" />
                    </div>
                }
            </div>
            <div class="form-actions">
                <button type="submit" name="formAction" value="save" class="btn btn-primary">💾 Save</button>
                <a href="/Users" class="btn btn-outline">Cancel</a>
            </div>
        </form>
    </section>
}

<!-- User list -->
@if (!Model.ShowForm)
{
    <section class="table-section">
        @if (Model.AllUsers.Any())
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Manager</th>
                        <th>Active</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.AllUsers)
                    {
                        <tr>
                            <td>@u.UserId</td>
                            <td>@u.UserName</td>
                            <td>@u.Email</td>
                            <td><span class="badge badge-@u.RoleName.ToLower()">@u.RoleName</span></td>
                            <td>@(u.ManagerName ?? "—")</td>
                            <td>@(u.IsActive ? "✅" : "❌")</td>
                            <td>
                                <a href="/Users?action=edit&userId=@u.UserId" class="btn btn-sm">Edit</a>
                                <form method="post" style="display:inline" onsubmit="return confirm('Deactivate this user?')">
                                    <input type="hidden" name="userId" value="@u.UserId" />
                                    <button type="submit" name="formAction" value="delete" class="btn btn-sm btn-danger">Deactivate</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty-state">No users found. <a href="/Users?action=create">Add the first user.</a></p>
        }
    </section>
}
